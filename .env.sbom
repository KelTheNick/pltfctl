# pltfctl SBOM — every pinned external artifact, by layer.
#
# Sourced by scripts/pltfctl. Entries tagged `deploy:<path>` are ALSO pinned in
# that manifest: bump both, or `doctor` fails. Why: scripts/README.md#the-sbom
# POSIX sh — plain KEY=value only, no expansion or substitution.

# --- Infrastructure (Kubernetes) -------------------------------------------
K3S_IMAGE_TAG=v1.34.1-k3s1   # floor: must ship CoreDNS >= 1.12.2
FLUX_VERSION=v2.9.4          # pinned, not `latest` — reproducibility

# --- Networking ------------------------------------------------------------
CILIUM_VERSION=1.19.5        # cilium-cli installs it, not Flux
GATEWAY_API_VERSION=v1.3.0   # standard-channel CRDs

# --- Charts ----------------------------------------------------------------
KUBE_ARGUS_CHART_VERSION=1.2.5  # deploy:k3d-base/kube-system/kube-argus.yaml
KGATEWAY_CHART_VERSION=2.3.5    # deploy:k3d-base/kube-system/kgateway.yaml (x2)
STRIMZI_VERSION=1.2.0           # chart + operator image; deploy:k3d-lite/kafka-system/strimzi-operator.yaml
KAFKA_VERSION=4.3.1             # Strimzi 1.2.0 default; deploy:k3d-lite/kafka-system/kraft.yaml

# --- Containers ------------------------------------------------------------
PODINFO_IMAGE=ghcr.io/stefanprodan/podinfo:6.9.2  # the only test image: server + every client
                                                  # (deploy:k3d-base/kube-public/podinfo.yaml,
                                                  #  deploy:k3d-base/default/verify-{http,tcp,tls,grpc}.yaml, verify probe pod)

# --- Compose (dev) ---------------------------------------------------------
# Read by infra/compose/dev.yaml through Compose's own ${VAR} interpolation
# (scripts/pltfctl exports them), so the compose file cannot drift from here.
AUTOMQ_IMAGE=automqinc/automq:1.7.4              # Kafka on S3, KRaft
RUSTFS_IMAGE=rustfs/rustfs:1.0.0                 # S3-compatible object store
MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z   # one-shot bucket creation (AutoMQ's own compose uses it)
