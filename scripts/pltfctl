#!/usr/bin/env sh
set -eu

# Resolve this script's real location, following symlinks, so the checkout
# root is derived from where the script actually lives, not from $PWD.
self=$0
while [ -h "$self" ]; do
  link=$(readlink -- "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
script_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd)

# Single source of truth for the checkout root. An exported PLTFCTL_HOME is
# honoured only as an explicit escape hatch; either way it is validated so a
# wrong root fails loudly instead of misbehaving downstream.
PLTFCTL_HOME=${PLTFCTL_HOME:-$(CDPATH='' cd -- "$script_dir/.." && pwd)}
[ -f "$PLTFCTL_HOME/scripts/lib/pltfctl/common.sh" ] || {
  printf '[err ] PLTFCTL_HOME is not a pltfctl checkout: %s\n' "$PLTFCTL_HOME" >&2
  exit 1
}
readonly PLTFCTL_HOME
export PLTFCTL_HOME

# Every external artifact version. Required, not optional: it is the only place
# these are defined, so a missing file must fail here rather than let the run
# proceed on whatever a downstream default happened to be.
# See scripts/README.md#the-sbom
[ -f "$PLTFCTL_HOME/.env.sbom" ] || {
  printf '[err ] .env.sbom not found at %s — it holds every pinned version\n' \
    "$PLTFCTL_HOME/.env.sbom" >&2
  exit 1
}
# .env.sbom names a version by its plain name (CILIUM_VERSION), the same
# name a caller exports to override it, so sourcing would clobber the
# override. Save it first and put it back after.
_cilium_override=${CILIUM_VERSION:-}
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../.env.sbom
. "$PLTFCTL_HOME/.env.sbom"
[ -z "$_cilium_override" ] || CILIUM_VERSION=$_cilium_override

# Inventory, the source of truth for everything this project creates, in
# three files: what every distro shares (the distro list, each one's kind),
# then the k3d clusters (names, ports, CIDRs, IDs, network, registry), then
# the Compose stack (project, ports). Each is required.
for _inv in infra/.infra.env infra/k3d/fleet.env infra/compose/compose.env; do
  [ -f "$PLTFCTL_HOME/$_inv" ] || {
    printf '[err ] %s not found at %s — it is part of the inventory\n' \
      "$_inv" "$PLTFCTL_HOME/$_inv" >&2
    exit 1
  }
done
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../infra/.infra.env
. "$PLTFCTL_HOME/infra/.infra.env"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../infra/k3d/fleet.env
. "$PLTFCTL_HOME/infra/k3d/fleet.env"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../infra/compose/compose.env
. "$PLTFCTL_HOME/infra/compose/compose.env"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/core/log.sh
. "$PLTFCTL_HOME/scripts/lib/core/log.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/common.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/common.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/flux.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/flux.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/cilium.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/cilium.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/cmds.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/cmds.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/status.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/status.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/sbom.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/sbom.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/images.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/images.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/verify_local.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/verify_local.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/compose.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/compose.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/kafka.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/kafka.sh"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/pltfctl/topic.sh
. "$PLTFCTL_HOME/scripts/lib/pltfctl/topic.sh"

# k3s image tag, from .env.sbom; override via K3D_TAG (must exist for your
# arch). Floor >= v1.34.1-k3s1 (CoreDNS 1.12.3): MCS-API's `multicluster`
# CoreDNS plugin for .clusterset.local requires CoreDNS >= 1.12.2.
K3D_TAG=${K3D_TAG:-$K3S_IMAGE_TAG}
export K3D_TAG

# Upstream resolver file bind-mounted into every node. Defaults to the
# in-repo file; override for an internal/corporate resolver behind a VPN or
# on an air-gapped host. See scripts/README.md#dns-and-pltf_resolv_conf
# pltf_render_k3d_config's plain `envsubst` cannot expand `${VAR:-default}`
# inside the YAML, so the default is resolved here, once, and exported.
PLTF_RESOLV_CONF=${PLTF_RESOLV_CONF:-$PLTFCTL_HOME/infra/k3d/network/resolv.conf}
export PLTF_RESOLV_CONF

usage() {
  cat <<'USAGE'
Usage:
  pltfctl up [lite|dev|fleet]   Stand a distro up. Default: lite.
  pltfctl down                  Delete every pltfctl k3d cluster (+ the
                                registry) and Compose stack (+ its volumes),
                                then `docker system prune -f` and `docker
                                volume prune -f` — HOST-WIDE, not just pltfctl.
  pltfctl status                Every component's health, then their total
                                CPU, memory and disk.
  pltfctl <component> status    One component: nodes cni mesh core flux gateway
                                samples event-bus. Exit 1 if unhealthy.
  pltfctl open [ui] [cluster]   List the fabric UIs, or open one in a browser.
  pltfctl verify                In-cluster: HTTP, TCP, TLS, gRPC. One cluster: Jobs in
                                default hit podinfo in kube-public. Fleet: the
                                same protocols across the ClusterMesh. Both: HTTP
                                from this host through the gateway (curl).
  pltfctl doctor                Verify required tools are on PATH + SBOM drift.
  pltfctl event-bus up [kraft|upgrade]
                                Add an event bus to the running k3d distro
                                (lite, or fleet's ops). Default: kraft
                                (Strimzi Kafka, KRaft, in kafka-system, at
                                KAFKA_BASE_VERSION). upgrade is a second Kafka
                                at the newer KAFKA_VERSION in kafka-upgrade,
                                with its own namespace-scoped operator; it needs
                                kraft up first.
  pltfctl event-bus down [upgrade]
                                Remove both buses and their data (upgrade
                                first), or only the upgrade bus.
  pltfctl event-bus status [upgrade]
                                Operator, Kafka, and each pod's state (live,
                                starting, CrashLoopBackOff...) and usage, then
                                the upgrade bus if on. Exit 0 when Ready.
  pltfctl event-topic create <topic> [--partitions N] [--replicas N]
  pltfctl event-topic delete <topic>
  pltfctl event-topic list      Topics and users on the event bus.
  pltfctl event-topic grant <user> <topic>[,<topic>...]
          [--access read|write|all] [--group G] [--produce B/s]
          [--consume B/s] [--request-pct N] [--csr FILE] [--out DIR]
                                A client identity: mTLS certificate, ACLs on
                                the topics, quotas. Writes ca.crt, user.crt,
                                user.key, client.properties to
                                .kafka-creds/<cluster>/<user>/. --csr signs the
                                client's own CSR (subject CN=<user>) instead.
  pltfctl event-topic revoke <user>
  pltfctl event-topic creds <user>
                                Print the cluster CA cert, client cert and
                                client key (PEM) to stdout.

Distros (one at a time; infra/.infra.env, infra/k3d/fleet.env, infra/compose/):
  lite   k3d-lite           Default. 1 server + 1 agent, plain Cilium (no
                            kube-proxy), registry, workload o11y stack
                            (planned).
                            http://<ui>.k3d.workbench.local.gd:8080
  dev    Docker Compose     One Kafka, no Kubernetes. Kafka localhost:9094.
                            VARIANT_KAFKA (infra/compose/.variant.env, or
                            exported) picks infra/compose/dev-<variant>.yaml:
                              strimzi-kraft  Strimzi's Kafka, KRaft (default)
  fleet  k3d-ops           One cluster, 1 server + 3 agents, Cilium with
                            ClusterMesh enabled (a second cluster can join),
                            registry, no o11y stack. Hosts are prefixed:
                            http://ops-<ui>…:8080

  `fleet` is for something that must keep working after a whole cluster is
  lost.

Every k3d distro runs Flux; in kube-system kgateway + the Gateway (/readyz
route); in kube-public one podinfo pod (HTTP
9898, TLS 9899, gRPC 9999) behind the podinfo smoke route. lite and fleet
export podinfo across the mesh and add the local OCI registry:
  push from host: oci://localhost:5001   in-cluster: oci-registry:5000
On dev, `verify` runs a Kafka produce/consume round trip and `open` lists its
endpoints; `status` and `<component> status` only print that they are not
available in dev mode (k3d distros only).

Environment:
  PLTFCTL_HOME     Root of the pltfctl checkout (auto-detected if unset).
  PLTF_ENABLE      Opt-in extras for `up`, space-separated (default: none):
                     hubble        Cilium's Hubble relay + UI (lite, fleet)
                   e.g. PLTF_ENABLE=hubble pltfctl up lite
  K3D_TAG          k3s image tag (default: from .env.sbom).
  CILIUM_VERSION   Cilium version (default: from .env.sbom).
  PLTF_RESOLV_CONF Upstream resolver file mounted into every node, in
                    resolv.conf format (default: infra/k3d/network/resolv.conf's public
                    resolvers). Override to point at an internal/corporate
                    resolver behind a VPN or on an air-gapped host.
USAGE
}

# Reject trailing args so typos fail fast instead of being silently dropped.
require_no_args() {
  if [ "$#" -gt 0 ]; then
    case "$1" in
      -h | --help) usage; exit 0 ;;
      *) pltf_die "Unknown argument: $1" ;;
    esac
  fi
}

main() {
  [ "$#" -ge 1 ] || { usage; exit 1; }
  subcmd=$1
  shift

  case "$subcmd" in
    up)
      distro=$PLTF_DEFAULT_DISTRO
      if [ "$#" -ge 1 ]; then
        case "$1" in
          -h | --help) usage; exit 0 ;;
          *)
            pltf_distro_known "$1" ||
              pltf_die "Unknown distro: $1 (expected: $(pltf_distro_names))"
            distro=$1; shift ;;
        esac
      fi
      require_no_args "$@"
      cmd_up "$distro"
      ;;
    down)   require_no_args "$@"; cmd_down ;;
    status) require_no_args "$@"; cmd_status ;;
    open)
      # Not require_no_args (open takes up to two), but the same intent: reject
      # a trailing arg instead of silently dropping it and acting on the wrong
      # cluster, and honour -h like every other subcommand.
      case "${1:-}" in -h | --help) usage; exit 0 ;; esac
      [ "$#" -le 2 ] ||
        pltf_die "Unknown argument: $3 (usage: open [<ui>] [<cluster>])"
      cmd_open "$@"
      ;;
    verify) require_no_args "$@"; cmd_verify ;;
    doctor) require_no_args "$@"; cmd_doctor ;;
    event-bus)
      action=${1:-}
      [ "$#" -eq 0 ] || shift
      case "$action" in
        up)
          bus=$PLTF_EVENT_BUS_DEFAULT
          if [ "$#" -ge 1 ]; then
            case "$1" in
              -h | --help) usage; exit 0 ;;
              *)
                pltf_event_bus_known "$1" ||
                  pltf_die "Unknown event bus: $1 (expected: $(pltf_event_bus_names))"
                bus=$1; shift ;;
            esac
          fi
          require_no_args "$@"
          cmd_event_bus_up "$bus"
          ;;
        down | status)
          bus=''
          if [ "$#" -ge 1 ]; then
            [ "$1" = upgrade ] ||
              pltf_die "Unknown event bus: $1 (down and status take: upgrade)"
            bus=$1; shift
          fi
          require_no_args "$@"
          if [ "$action" = down ]; then cmd_event_bus_down "$bus"; else cmd_event_bus_status "$bus"; fi
          ;;
        -h | --help) usage ;;
        *) pltf_die "Usage: pltfctl event-bus up [$(pltf_event_bus_names)] | down [upgrade] | status [upgrade]" ;;
      esac
      ;;
    event-topic)
      action=${1:-}
      [ "$#" -eq 0 ] || shift
      case "$action" in
        create) cmd_topic_create "$@" ;;
        delete) cmd_topic_delete "$@" ;;
        list) require_no_args "$@"; cmd_topic_list ;;
        grant) cmd_topic_grant "$@" ;;
        revoke) cmd_topic_revoke "$@" ;;
        creds) cmd_topic_creds "$@" ;;
        -h | --help) usage ;;
        *) pltf_die "Usage: pltfctl event-topic create | delete | list | grant | revoke | creds" ;;
      esac
      ;;
    -h | --help | help) usage ;;
    *)
      # `pltfctl <component> status`, the shape `event-bus status` set.
      # event-bus keeps its own case above for up/down.
      pltf_component_known "$subcmd" || pltf_die "Unknown subcommand: $subcmd"
      case "${1:-}" in
        status) shift; require_no_args "$@"; cmd_status "$subcmd" ;;
        -h | --help) usage ;;
        *) pltf_die "Usage: pltfctl $subcmd status" ;;
      esac
      ;;
  esac
}

main "$@"
