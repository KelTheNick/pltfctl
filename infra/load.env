# pltfctl load — Kafka load-generation tunables (`pltfctl load`). Unlike
# fleet.env and compose.env, these are deliberately `: "${VAR:=default}"`
# defaults, not plain assignments: load's whole point is a knob changed for
# one run (`PLTF_LOAD_THROUGHPUT=1000 pltfctl load up`), where the rest of the
# inventory is fixed and nothing should override it.
#
# load does not create Kafka. It needs an already-running event bus
# (`pltfctl event-bus up`); the target cluster and Kafka resource name are
# discovered at runtime (scripts/lib/pltfctl/topic.sh:pltf_topic_target), the
# same way `event-topic` finds them. Read by scripts/lib/pltfctl/load.sh.

# ----- Where the load runs ---------------------------------------------------
: "${PLTF_LOAD_NS:=sif-workloads}"            # namespace for producers and consumers
: "${PLTF_LOAD_PRODUCER_PREFIX:=sif-load}"    # producer StatefulSets and their topics: sif-load-01 ..
: "${PLTF_LOAD_CONSUMER_PREFIX:=sif-consume}" # consumer StatefulSets / groups: sif-consume-01 ..
# Where clients connect. Empty picks the running bus's own Kafka Service
# (<kafka-cluster>-kafka-bootstrap.<PLTF_EVENT_BUS_NS>:9092). Export to
# bootstrap through a Cilium ClusterMesh clusterset name instead:
# wiki/devsecops/10-load-generation.md#bootstrap-through-the-mesh
: "${PLTF_LOAD_BOOTSTRAP:=}"

# ----- Topics -----------------------------------------------------------------
: "${PLTF_LOAD_TOPIC_COUNT:=20}"
# 9 partitions over RF 3 on 3 brokers: leaders land 3 per broker, and 9
# consumers read one partition each. wiki/devsecops/10-load-generation.md
: "${PLTF_LOAD_PARTITIONS:=9}"
: "${PLTF_LOAD_REPLICAS:=3}"
: "${PLTF_LOAD_MIN_ISR:=2}"

# ----- Producers (kafka-producer-perf-test.sh) -------------------------------
: "${PLTF_LOAD_PRODUCERS:=5}"      # replicas per topic when started
: "${PLTF_LOAD_THROUGHPUT:=3000}"  # records/s per producer pod
: "${PLTF_LOAD_RECORD_SIZE:=1024}" # bytes
: "${PLTF_LOAD_ACKS:=all}"
: "${PLTF_LOAD_IDEMPOTENCE:=true}"
: "${PLTF_LOAD_LINGER_MS:=5}"
: "${PLTF_LOAD_BATCH_SIZE:=65536}"
: "${PLTF_LOAD_COMPRESSION:=lz4}"

# ----- Consumers (kafka-consumer-perf-test.sh) -------------------------------
: "${PLTF_LOAD_CONSUMERS:=9}" # replicas per group when started; match PLTF_LOAD_PARTITIONS

# ----- Pods -------------------------------------------------------------------
: "${PLTF_LOAD_HEAP:=-Xms64m -Xmx64m}" # JVM heap of each load pod
: "${PLTF_LOAD_CPU_REQUEST:=100m}"
: "${PLTF_LOAD_MEMORY_REQUEST:=128Mi}"
: "${PLTF_LOAD_MEMORY_LIMIT:=192Mi}"
# `load start` refuses to scale past this many pods at once unless --force:
# each is a JVM of about 150Mi, so a laptop runs out of memory long before it
# runs out of topics.
: "${PLTF_LOAD_MAX_PODS:=10}"
