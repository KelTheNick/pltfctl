# pltfctl fleet inventory — the single source of truth for every process,
# container and network this project owns.
#
# Read by scripts/pltfctl and scripts/projctl (sourced) and rendered into
# infra/k3d/<distro>/<cluster>.yaml via envsubst. Change a value HERE, never
# in a k3d config or a script.
# Every value is create-time only: changing one needs `down` + `up`.
# POSIX sh — plain KEY=value only, no expansion or substitution.

# --- Distros ---------------------------------------------------------------
# lite | dev (default) | fleet. One distro runs at a time: they reuse the
# same host ports, and `pltfctl up` refuses to start a second one.
PLTF_DISTROS='lite dev fleet'
PLTF_DEFAULT_DISTRO=dev

# Per distro:
#   CLUSTERS  creation order (the first owns the registry and Cilium CA).
#   CNI       flannel = k3s default + kube-proxy;
#             cilium  = Cilium with kube-proxy replacement (eBPF).
#   REGISTRY  true = the first cluster creates the OCI registry.
#   O11Y      true = a lightweight workload-observability stack is deployed.
#             (Declared only; not wired yet. Hubble is separate: it ships
#             with Cilium on every cilium distro.)
PLTF_DISTRO_LITE_CLUSTERS='lite'
PLTF_DISTRO_LITE_CNI=flannel
PLTF_DISTRO_LITE_REGISTRY=false
PLTF_DISTRO_LITE_O11Y=false

PLTF_DISTRO_DEV_CLUSTERS='dev'
PLTF_DISTRO_DEV_CNI=cilium
PLTF_DISTRO_DEV_REGISTRY=true
PLTF_DISTRO_DEV_O11Y=true

PLTF_DISTRO_FLEET_CLUSTERS='op-1 op-2 op-3'
PLTF_DISTRO_FLEET_CNI=cilium
PLTF_DISTRO_FLEET_REGISTRY=true
PLTF_DISTRO_FLEET_O11Y=false

# Every cluster across every distro, in teardown-safe order (a registry- and
# CA-owning first cluster is deleted after its peers). `down` walks this.
PLTF_ALL_CLUSTERS='op-3 op-2 op-1 dev lite'

# --- Shared ----------------------------------------------------------------
# Shared Docker network: ClusterMesh exposes clustermesh-apiserver as a
# NodePort, so every cluster's node IPs must be mutually routable.
PLTF_NETWORK=k3d-pltfctl

# API server host name (resolves to 127.0.0.1 via local.gd).
PLTF_API_HOST=k3d.local.gd

# UI / route domain: <prefix>-<ui>.<domain> when the cluster has a
# HOST_PREFIX, else <ui>.<domain>.
PLTF_DOMAIN=k3d.workbench.local.gd

# --- Artifact repository (OCI registry; dev and fleet only) ----------------
# k3d does NOT prefix the registry's own name with "k3d-" (unlike nodes).
PLTF_REGISTRY_NAME=oci-registry
PLTF_REGISTRY_HOST_PORT=5001      # host:       oci://localhost:5001
PLTF_REGISTRY_PORT=5000           # in-cluster: oci-registry:5000

# --- Per cluster -----------------------------------------------------------
# Ports follow the 4-digit convention (655x API, x080 HTTP, x443 HTTPS).
# The 4-digit rule wins over ascending order: op-1 takes 8xxx and op-2 9xxx,
# so op-3 takes the 7xxx band rather than a five-digit 10080/10443. Ports
# therefore read out of order by cluster (7=op-3, 8=op-1, 9=op-2); that is
# deliberate, and the lesser of the two inconsistencies.
# Within a distro they must be unique; across distros they deliberately
# repeat. CIDRs must not overlap within a meshed distro (hard ClusterMesh
# rule). ID is the Cilium cluster ID (1-255; cilium distros only).
# HOST_PREFIX: empty = <ui>.<domain>; set = <prefix>-<ui>.<domain>.
# Keys use the cluster name upper-cased with '-' as '_' (op-1 -> PLTF_OP_1_*).

PLTF_LITE_API_PORT=6550
PLTF_LITE_HTTP_PORT=8080
PLTF_LITE_HTTPS_PORT=8443         # reserved; no TLS listener yet
PLTF_LITE_POD_CIDR=10.42.0.0/16
PLTF_LITE_SVC_CIDR=10.43.0.0/16
PLTF_LITE_DNS_IP=10.43.0.10
PLTF_LITE_HOST_PREFIX=

PLTF_DEV_ID=1
PLTF_DEV_API_PORT=6550
PLTF_DEV_HTTP_PORT=8080
PLTF_DEV_HTTPS_PORT=8443
PLTF_DEV_POD_CIDR=10.42.0.0/16
PLTF_DEV_SVC_CIDR=10.43.0.0/16
PLTF_DEV_DNS_IP=10.43.0.10
PLTF_DEV_HOST_PREFIX=

PLTF_OP_1_ID=1
PLTF_OP_1_API_PORT=6550
PLTF_OP_1_HTTP_PORT=8080
PLTF_OP_1_HTTPS_PORT=8443
PLTF_OP_1_POD_CIDR=10.42.0.0/16
PLTF_OP_1_SVC_CIDR=10.43.0.0/16
PLTF_OP_1_DNS_IP=10.43.0.10
PLTF_OP_1_HOST_PREFIX=op-1

PLTF_OP_2_ID=2
PLTF_OP_2_API_PORT=6551
PLTF_OP_2_HTTP_PORT=9080
PLTF_OP_2_HTTPS_PORT=9443
PLTF_OP_2_POD_CIDR=10.44.0.0/16
PLTF_OP_2_SVC_CIDR=10.45.0.0/16
PLTF_OP_2_DNS_IP=10.45.0.10
PLTF_OP_2_HOST_PREFIX=op-2

PLTF_OP_3_ID=3
PLTF_OP_3_API_PORT=6552
PLTF_OP_3_HTTP_PORT=7080
PLTF_OP_3_HTTPS_PORT=7443
PLTF_OP_3_POD_CIDR=10.46.0.0/16
PLTF_OP_3_SVC_CIDR=10.47.0.0/16
PLTF_OP_3_DNS_IP=10.47.0.10
PLTF_OP_3_HOST_PREFIX=op-3

# --- Event bus -------------------------------------------------------------
# A toggle, not part of `up`: `pltfctl event-bus up [bus]` / `event-bus down`
# on the running distro (lite and dev; fleet has no manifests). `up` skips
# the namespace below entirely.
#   kraft  Strimzi Kafka in KRaft mode (deploy/<ctx>/kafka-system/kraft.yaml).
PLTF_EVENT_BUSES='kraft'
PLTF_EVENT_BUS_DEFAULT=kraft
PLTF_EVENT_BUS_NS=kafka-system
