# Which Kafka the dev distro runs. Read by `pltfctl up dev` (and verify, open,
# down) to pick infra/compose/dev-<VARIANT_KAFKA>.yaml. An exported
# VARIANT_KAFKA overrides this file for one run:
#   VARIANT_KAFKA=automq ./scripts/pltfctl up dev
# POSIX sh: plain KEY=value only.
#
#   strimzi-kraft  (default) Strimzi's Kafka image, KRaft, local volume.
#                  Shared-nothing; the same build lite's operator runs.
#   aiven-tiered   Apache Kafka + Aiven's tiered-storage plugin (KIP-405),
#                  closed segments offloaded to RustFS.
#   automq         AutoMQ: Kafka with its log in S3 (RustFS). Shared-data.
#
# Switching: `pltfctl down` first. One variant runs at a time, and `up`
# refuses while a different one is running.
VARIANT_KAFKA=strimzi-kraft
