# pltfctl shared inventory — settings every distro, k3d or Compose, depends
# on. k3d-only values live in infra/k3d/fleet.env, Compose-only ones in
# infra/compose/compose.env.
#
# Read first by scripts/pltfctl and scripts/projctl (sourced).
# POSIX sh — plain KEY=value only, no expansion or substitution.

# --- Distros ---------------------------------------------------------------
# lite (default) | dev | fleet. One distro runs at a time: `pltfctl up`
# refuses to start a second one.
PLTF_DISTROS='lite dev fleet'
PLTF_DEFAULT_DISTRO=lite

# KIND per distro: k3d (default when unset) = Kubernetes clusters, defined in
# infra/k3d/fleet.env; compose = a Docker Compose stack, infra/compose/.
PLTF_DISTRO_DEV_KIND=compose
