# pltfctl k3d inventory — every k3d cluster, port, CIDR, network and registry
# this project creates. k3d distros only; settings every distro shares live in
# infra/.infra.env, the Compose distro's in infra/compose/compose.env.
#
# Read by scripts/pltfctl and scripts/projctl (sourced, after .infra.env) and
# rendered into infra/k3d/<distro>/<cluster>.yaml via envsubst. Change a value
# HERE, never in a k3d config or a script.
# Every value is create-time only: changing one needs `down` + `up`.
# POSIX sh — plain KEY=value only, no expansion or substitution.

# --- k3d distros -----------------------------------------------------------
# Per k3d distro:
#   CLUSTERS  creation order (the first owns the registry and Cilium CA).
#   CNI       flannel = k3s default + kube-proxy;
#             cilium  = Cilium with kube-proxy replacement (eBPF).
#   REGISTRY  true = the first cluster creates the OCI registry.
#   MESH      true = ClusterMesh is enabled (clustermesh-apiserver) and every
#             cluster of the distro is connected to the others. false =
#             plain single-cluster Cilium.
#   O11Y      true = a lightweight workload-observability stack is deployed.
#             (Declared only; not wired yet. Hubble is separate: it ships
#             with Cilium on every cilium distro.)
PLTF_DISTRO_LITE_CLUSTERS='lite'
PLTF_DISTRO_LITE_CNI=cilium
PLTF_DISTRO_LITE_REGISTRY=true
PLTF_DISTRO_LITE_O11Y=true
PLTF_DISTRO_LITE_MESH=false

PLTF_DISTRO_FLEET_CLUSTERS='ops'
PLTF_DISTRO_FLEET_CNI=cilium
PLTF_DISTRO_FLEET_REGISTRY=true
PLTF_DISTRO_FLEET_O11Y=false
PLTF_DISTRO_FLEET_MESH=true

# Every cluster across every distro, in teardown-safe order (a registry- and
# CA-owning first cluster is deleted after its peers). `down` walks this.
PLTF_ALL_CLUSTERS='ops lite'

# Clusters an older pltfctl created under names no distro uses any more
# (`dev` was the k3d distro before it became Compose). `down` still removes
# them, so a checkout update never strands one.
PLTF_LEGACY_CLUSTERS='dev'

# --- Across k3d clusters ---------------------------------------------------
# Docker network every k3d cluster joins: ClusterMesh exposes clustermesh-apiserver as a
# NodePort, so every cluster's node IPs must be mutually routable.
PLTF_NETWORK=k3d-pltfctl

# API server host name (resolves to 127.0.0.1 via local.gd).
PLTF_API_HOST=k3d.local.gd

# UI / route domain: <prefix>-<ui>.<domain> when the cluster has a
# HOST_PREFIX, else <ui>.<domain>.
PLTF_DOMAIN=k3d.workbench.local.gd

# --- Artifact repository (OCI registry; lite and fleet only) ---------------
# k3d does NOT prefix the registry's own name with "k3d-" (unlike nodes).
PLTF_REGISTRY_NAME=oci-registry
PLTF_REGISTRY_HOST_PORT=5001      # host:       oci://localhost:5001
PLTF_REGISTRY_PORT=5000           # in-cluster: oci-registry:5000

# --- Per cluster -----------------------------------------------------------
# Ports follow the 4-digit convention (655x API, x080 HTTP, x443 HTTPS).
# Within a distro they must be unique; across distros they deliberately
# repeat. CIDRs must not overlap within a meshed distro (hard ClusterMesh
# rule). ID is the Cilium cluster ID (1-255; cilium distros only).
# HOST_PREFIX: empty = <ui>.<domain>; set = <prefix>-<ui>.<domain>.
# Keys use the cluster name upper-cased with '-' as '_' (ops -> PLTF_OPS_*).

PLTF_LITE_ID=1
PLTF_LITE_API_PORT=6550
PLTF_LITE_HTTP_PORT=8080
PLTF_LITE_HTTPS_PORT=8443
PLTF_LITE_POD_CIDR=10.42.0.0/16
PLTF_LITE_SVC_CIDR=10.43.0.0/16
PLTF_LITE_DNS_IP=10.43.0.10
PLTF_LITE_HOST_PREFIX=

PLTF_OPS_ID=1
PLTF_OPS_API_PORT=6550
PLTF_OPS_HTTP_PORT=8080
PLTF_OPS_HTTPS_PORT=8443
PLTF_OPS_POD_CIDR=10.42.0.0/16
PLTF_OPS_SVC_CIDR=10.43.0.0/16
PLTF_OPS_DNS_IP=10.43.0.10
PLTF_OPS_HOST_PREFIX=ops

# --- Event bus -------------------------------------------------------------
# A toggle, not part of `up`: `pltfctl event-bus up [bus]` / `event-bus down`
# on the running distro (lite or fleet; dev's Kafka
# is Strimzi's Kafka image, in its Compose stack). `up` skips
# the namespace below entirely.
#   kraft  Strimzi Kafka in KRaft mode, in PLTF_EVENT_BUS_NS
#          (deploy/<ctx>/kafka-system/kraft.yaml), at KAFKA_BASE_VERSION.
# A context that also has deploy/<ctx>/kafka-upgrade/ (fleet's ops) gets a
# second Kafka there, at the newer KAFKA_VERSION, with its own
# namespace-scoped operator. `up` installs it after the first, `down` removes
# it first: it reuses the first release's CRDs and ClusterRoles.
PLTF_EVENT_BUSES='kraft'
PLTF_EVENT_BUS_DEFAULT=kraft
PLTF_EVENT_BUS_NS=kafka-system
PLTF_EVENT_BUS_SECOND_NS=kafka-upgrade

